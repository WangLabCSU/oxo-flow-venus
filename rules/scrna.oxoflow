[workflow]
name = "venus-scrna"
description = "Single-cell RNA-seq: c4-platform FASTQs → dnbc4tools counting → per-sample QC/clustering → cohort summary"

# Single-cell FASTQs from the c4 platform: Pt{NN}-SC_R{1,2} (cDNA) +
# Pt{NN}-SC-oligo_R{1,2} (oligo/sample index). The raw/ stage symlinks these
# under the same names. dnbc4tools 3.0 verified CLI:
#   dnbc4tools rna run -n NAME -c1 cDNA_R1 -c2 cDNA_R2 -i1 oligo_R1 -i2 oligo_R2
#                      -g genomeDir -o outdir -t threads
#                      [--chemistry auto|scRNAv1HT|scRNAv2HT|scRNAv3HT|scRNAv5P]
#                      [--calling_method emptydrops|barcoderanks] [--minumi N]
# Real outputs: outs/raw_matrix/{matrix.mtx.gz,features.tsv.gz,barcodes.tsv.gz},
# outs/filter_feature.h5ad, outs/analysis/{QC_Cluster.h5ad,marker.csv,cluster.csv},
# outs/singlecell.csv, outs/metrics_summary.xls.

# FastQC on raw single-cell FASTQs (no trimming: dnbc4tools expects raw).
# Gated via groups.tsv `assay` so these rules only fan over the scRNA group.
[[rules]]
name = "scrna_fastqc"
description = "FastQC on raw single-cell FASTQs"
when = "wildcard.assay == 'scrna'"
input = [
    "raw/{sample}_SC_R1.fastq.gz",
    "raw/{sample}_SC_R2.fastq.gz",
    "raw/{sample}_SC-oligo_R1.fastq.gz",
    "raw/{sample}_SC-oligo_R2.fastq.gz",
]
output = [
    "scrna/fastqc/{sample}_SC_R1_fastqc.html",
    "scrna/fastqc/{sample}_SC_R2_fastqc.html",
]
# QC measurement reports (same treatment as the DNA/bulkRNA fastqc HTMLs) and
# ingestion inputs of the protected MultiQC report — survive every clean.
protected_output = [
    "scrna/fastqc/{sample}_SC_R1_fastqc.html",
    "scrna/fastqc/{sample}_SC_R2_fastqc.html",
]
log = "logs/scrna_fastqc/{sample}.log"
threads = 4
memory = "4G"
environment = { pixi = "envs/qc/pixi.toml" }
shell = """
mkdir -p scrna/fastqc logs/scrna_fastqc && \
fastqc --threads {threads} --outdir scrna/fastqc {input[0]} {input[1]} 2> {log}
"""

# Cell calling + UMI counting (dnbc4tools rna run; outputs under <outdir>/<name>/outs/).
[[rules]]
name = "scrna_count"
description = "Cell calling and UMI counting (dnbc4tools rna run)"
when = "wildcard.assay == 'scrna'"
input = [
    "raw/{sample}_SC_R1.fastq.gz",
    "raw/{sample}_SC_R2.fastq.gz",
    "raw/{sample}_SC-oligo_R1.fastq.gz",
    "raw/{sample}_SC-oligo_R2.fastq.gz",
]
output = [
    "scrna/count/{sample}/outs/raw_matrix/matrix.mtx.gz",
    "scrna/count/{sample}/outs/raw_matrix/features.tsv.gz",
    "scrna/count/{sample}/outs/raw_matrix/barcodes.tsv.gz",
    "scrna/count/{sample}/outs/filter_feature.h5ad",
    "scrna/count/{sample}/outs/analysis/cluster.csv",
    "scrna/count/{sample}/outs/analysis/marker.csv",
    "scrna/count/{sample}/outs/metrics_summary.xls",
]
# Keep the analysis products (h5ad, cluster/marker tables, metrics) AND all
# four count matrices: `filter_matrix/` is the 10x MEX trio that Seurat's
# Read10X ingests directly, `raw_matrix/` is the unfiltered (all-barcodes)
# matrix that ambient-RNA/doublet tools (SoupX, DecontX, scDblFinder) need.
# Both are 10x MEX trios (~1.65 GB/sample combined) and unrecoverable without
# re-running the most expensive recompute in the pipeline (dnbc4tools, days
# of 16-thread/64G compute per sample) — treat these protections as
# load-bearing. The per-sample report HTML (2.8 MB) is the dnbc4tools QC
# deliverable. filter_matrix/ and the report are not declared outputs (the
# engine never tracks them); the protection is pattern-based and future-proofs
# them if they are ever formally declared. NOT protected: the per-cell
# terminal results `outs/analysis/QC_Cluster.h5ad` (~1 GB/sample) and
# `outs/singlecell.csv` (~98 MB/sample) — S4's tarball archives them.
protected_output = [
    "scrna/count/{sample}/outs/raw_matrix/matrix.mtx.gz",
    "scrna/count/{sample}/outs/raw_matrix/features.tsv.gz",
    "scrna/count/{sample}/outs/raw_matrix/barcodes.tsv.gz",
    "scrna/count/{sample}/outs/filter_matrix/matrix.mtx.gz",
    "scrna/count/{sample}/outs/filter_matrix/features.tsv.gz",
    "scrna/count/{sample}/outs/filter_matrix/barcodes.tsv.gz",
    "scrna/count/{sample}/outs/filter_feature.h5ad",
    "scrna/count/{sample}/outs/analysis/cluster.csv",
    "scrna/count/{sample}/outs/analysis/marker.csv",
    "scrna/count/{sample}/outs/metrics_summary.xls",
    "scrna/count/{sample}/outs/{sample}_scRNA_report.html",
]
log = "logs/scrna_count/{sample}.log"
threads = 16
memory = "64G"
environment = { pixi = "envs/scrna/pixi.toml" }
shell = """
mkdir -p scrna/count logs/scrna_count && \
{config.scrna_bin} rna run \
    -n {sample} \
    -c1 {input[0]} \
    -c2 {input[1]} \
    -i1 {input[2]} \
    -i2 {input[3]} \
    -g {config.scrna_reference} \
    -o scrna/count \
    -t {threads} \
    --chemistry {config.scrna_chemistry} \
    --darkreaction {config.scrna_darkreaction} \
    --minumi {config.scrna_min_umi} \
    2> {log}
"""

# Per-sample cluster/marker summary (pure-python over dnbc4tools outputs).
[[rules]]
name = "scrna_qc_cluster"
description = "Summarize clusters and marker genes per sample"
when = "wildcard.assay == 'scrna'"
input = [
    "scrna/count/{sample}/outs/analysis/cluster.csv",
    "scrna/count/{sample}/outs/analysis/marker.csv",
]
output = [
    "scrna/qc/{sample}.clusters.tsv",
]
# Keep: report-facing per-sample QC table.
protected_output = [
    "scrna/qc/{sample}.clusters.tsv",
]
threads = 2
memory = "4G"
environment = { pixi = "envs/report/pixi.toml" }
shell = """
mkdir -p scrna/qc logs && \
python {config.venus_tools}/scrna_qc_cluster.py \
    --cluster {input[0]} \
    --markers {input[1]} \
    --sample {sample} \
    --output {output[0]} \
    2> logs/scrna_qc_cluster_{sample}.log
"""

# Cohort-level single-cell summary table.
[[rules]]
name = "scrna_integrate"
description = "Aggregate per-sample cluster tables into cohort summary"
expand_inputs = [{ pattern = "scrna/qc/{sample}.clusters.tsv", variables = { sample = "config.samples_scRNA" } }]
output = ["scrna/cohort_clusters.tsv"]
# Keep: cohort single-cell summary consumed by the report module.
protected_output = ["scrna/cohort_clusters.tsv"]
threads = 2
memory = "4G"
environment = { pixi = "envs/report/pixi.toml" }
shell = """
mkdir -p logs && \
python {config.venus_tools}/scrna_integrate.py \
    --clusters {input} \
    --output {output} \
    2> logs/scrna_integrate.log
"""
