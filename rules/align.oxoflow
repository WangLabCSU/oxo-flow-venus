[workflow]
name = "venus-align"
description = "DNA alignment: BWA-MEM2 + samtools sort + Picard MarkDuplicates + BQSR"

# BWA-MEM2 alignment with read-group header, coordinate-sorted BAM.
# Gated to DNA samples via the groups.tsv `assay` column.
[[rules]]
name = "bwa_mem2"
description = "Align reads to GRCh38 with BWA-MEM2"
when = "wildcard.assay == 'wgs'"
input = [
    "{config.genome_fa}",
    "qc/trim/{sample}_R1.trim.fastq.gz",
    "qc/trim/{sample}_R2.trim.fastq.gz",
]
output = ["align/{sample}/{sample}.sorted.bam"]
# Pure scratch: mark_duplicates consumes it immediately and bqsr keeps the
# final BAM. Sorted-BAM scratch is the second-largest reclaimable intermediate
# (~hundreds of GB). NOTE: tombstone cleanup for wildcard rules is pending
# engine support (see docs/cleanup.md).
temporary = true
log = "logs/bwa_mem2/{sample}.log"
threads = 16
memory = "64G"
environment = { pixi = "envs/align/pixi.toml" }
params.read_group = "@RG\\tID:{sample}\\tSM:{sample}\\tPL:{config.read_group_platform}\\tLB:{sample}"
shell = """
mkdir -p align/{sample} logs/bwa_mem2 && \
bwa-mem2 mem -t {threads} -R '{params.read_group}' \
    {config.bwa_prefix} {input[1]} {input[2]} \
    2> {log} \
  | samtools sort -@ 8 -m 2G -o {output} -
"""

# Mark PCR duplicates — required for somatic variant calling.
[[rules]]
name = "mark_duplicates"
description = "Mark PCR duplicates with Picard"
when = "wildcard.assay == 'wgs'"
input = ["align/{sample}/{sample}.sorted.bam"]
output = [
    "align/{sample}/{sample}.markdup.bam",
    "align/{sample}/{sample}.dup_metrics.txt",
]
# Duplicate rate is a library QC measurement (goes into methods/QC review and
# feeds the protected MultiQC report). The markdup BAM itself stays deletable;
# the metrics file survives every clean.
protected_output = ["align/{sample}/{sample}.dup_metrics.txt"]
log = "logs/mark_duplicates/{sample}.log"
threads = 4
memory = "24G"
environment = { pixi = "envs/align/pixi.toml" }
shell = """
mkdir -p logs/mark_duplicates && \
picard MarkDuplicates \
    -I {input} -O {output[0]} -M {output[1]} \
    --CREATE_INDEX true \
    --VALIDATION_STRINGENCY LENIENT \
    --TMP_DIR tmp/picard/{sample} \
    -Xmx{effective_memory_mb}m \
    2> {log}
"""

# BQSR: learn recalibration model, then apply.
[[rules]]
name = "bqsr"
description = "Base quality score recalibration (GATK BQSR)"
input = [
    "align/{sample}/{sample}.markdup.bam",
    "{config.dbsnp}",
    "{config.mills}",
    "{config.genome_dict}",
]
output = [
    "bqsr/{sample}/{sample}.recal.table",
    "bqsr/{sample}/{sample}.bqsr.bam",
    "bqsr/{sample}/{sample}.bqsr.bai",
]
# Analysis-ready BAMs: every caller downstream (Mutect2, Manta, ASCAT,
# CNVkit, MSIsensor) consumes them, so a clean that deletes them turns ANY
# re-analysis into a full BWA-MEM2 realignment (days over 20 WGS samples).
# Same standing as TCGA-style aligned BAMs: archive-grade intermediates.
# The recal.table is the BQSR model itself — KB-scale, keep it as audit
# evidence. ~1 TB cohort-wide, by far the largest protection.
protected_output = [
    "bqsr/{sample}/{sample}.recal.table",
    "bqsr/{sample}/{sample}.bqsr.bam",
    "bqsr/{sample}/{sample}.bqsr.bai",
]
log = "logs/bqsr/{sample}.log"
threads = 8
memory = "32G"
environment = { pixi = "envs/varcall/pixi.toml" }
when = "config.run_bqsr == 'true' && wildcard.assay == 'wgs'"
shell = """
mkdir -p bqsr/{sample} logs/bqsr && \
gatk --java-options "-Xmx{effective_memory_mb}m" BaseRecalibrator \
    -R {config.genome_fa} -I {input[0]} \
    --known-sites {input[1]} --known-sites {input[2]} \
    -O {output[0]} \
    2>> {log} && \
gatk --java-options "-Xmx{effective_memory_mb}m" ApplyBQSR \
    -R {config.genome_fa} -I {input[0]} \
    --bqsr-recal-file {output[0]} \
    -O {output[1]} \
    2>> {log}
"""
