[workflow]
name = "venus-msi"
description = "Microsatellite instability with MSIsensor-pro (paired tumor-normal)"

# MSIsensor-pro supports two modes: `msi` (paired tumor-normal) and `pro`
# (single-sample, but ONLY against a prebuilt baseline from a panel of
# normals — not something a single-cohort run can produce). Venus therefore
# gates MSI on the presence of a matched normal (when = control != '') and
# documents tumor-only MSI as not supported. The genome `scan` is a one-time,
# cohort-shared step (~1-3 h on hg38) run once per workdir.
#
# The scan uses MSIsensor-pro's default microsatellite criteria; it reads the
# reference FASTA directly (no .fai needed). Capture-restricted MSI is NOT
# supported: msisensor-pro has no BED flag — its `-b` sets the THREAD count
# (the rule binds it to {threads}) — so `config.msi_targets_args` is reserved
# and MUST stay empty; a BED path passed there would silently be consumed as
# the thread count. For WES/panel runs the only lever is raising
# `config.msi_coverage` (see README "WES/panel compatibility checklist").
[[rules]]
name = "msisensor_scan"
description = "Scan reference genome for microsatellites (cohort-shared, once)"
input = ["{config.genome_fa}"]
output = ["msi/reference.list"]
# The reference scan is a detection-input result of the MSI module and costs
# 1-3 h of compute on hg38; protect it so `clean` never deletes it.
protected_output = ["msi/reference.list"]
threads = 4
memory = "8G"
environment = { pixi = "envs/msi/pixi.toml" }
shell = """
mkdir -p msi logs && \
msisensor-pro scan -d {input[0]} -o msi/reference.list \
    > logs/msisensor_scan.log 2>&1
"""

[[rules]]
name = "msi_paired"
description = "MSIsensor-pro MSI scoring with matched normal"
input = [
    "msi/reference.list",
    "bqsr/{experiment}/{experiment}.bqsr.bam",
    "bqsr/{control}/{control}.bqsr.bam",
]
output = ["deliver/{pair_id}.msi.tsv"]
# Per-pair MSI score is a clinical detection result — must survive any clean.
# `{pair_id}_all` (per-locus detail) is evidence-grade: the protected
# `report/msi_cohort.tsv` BH-corrects over its per-locus counts. `_unstable`
# (114 B) is the instability summary. Both are written beside the declared
# output rather than declared themselves; protecting them here is pattern-
# based (valid without an output-list change, so no completed instance goes
# stale) and already covers them if they are ever formally declared. `_dis`
# (~1.1 GB/pair of per-locus distributions) stays deletable — the only MSI
# leftover worth reclaiming for space.
protected_output = [
    "deliver/{pair_id}.msi.tsv",
    "msi/{pair_id}_all",
    "msi/{pair_id}_unstable",
]
threads = 4
memory = "8G"
environment = { pixi = "envs/msi/pixi.toml" }
when = "wildcard.control != ''"
# msisensor-pro `msi` writes per-base scratch files (literally named A, C,
# G, T) into its CURRENT WORKING DIRECTORY. Run from the workdir root those
# undeclared files land at the workdir root, where the engine never manages
# them — and with several instances running concurrently (-j > 1) they would
# all write to the SAME four paths. Run each instance in its own scratch
# directory instead: everything the tool follows CWD for stays isolated,
# while the declared outputs (-o …_all/_unstable/_dis and the delivered TSV)
# keep their workdir-relative locations. Scratch is wiped before the run
# (deterministic retries) and after success; it is deliberately kept on
# failure for forensics. The subshell confines the `cd`.
shell = """
mkdir -p deliver logs && \
wd=$PWD && rm -rf msi_scratch/{pair_id} && mkdir -p msi_scratch/{pair_id} && \
( cd msi_scratch/{pair_id} && \
  msisensor-pro msi -d "$wd/msi/reference.list" \
      -t "$wd/bqsr/{experiment}/{experiment}.bqsr.bam" \
      -n "$wd/bqsr/{control}/{control}.bqsr.bam" \
      -o "$wd/msi/{pair_id}" -c {config.msi_coverage} -b {threads} \
      {config.msi_targets_args} ) \
    > logs/msisensor_{pair_id}.log 2>&1 && \
rm -rf msi_scratch/{pair_id} && \
mv msi/{pair_id} deliver/{pair_id}.msi.tsv
"""
