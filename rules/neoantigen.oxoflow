[workflow]
name = "venus-neoantigen"
description = "Neoantigen module: SpecHLA typing -> VEP plugin re-annotation -> pVACseq (MHCflurry P0) -> burden report (venus#31)"

# B2 (audit): pVACtools hard-requires VEP Perl-plugin CSQ fields
# (FrameshiftSequence, WildtypeProtein, TSL) that the vep-rs annotation does
# not carry, so the PASS VCF is re-annotated with standard offline VEP +
# Wildtype/Frameshift plugins into a neoantigen-private deliverable. vep-rs
# output remains the clinical/MAF annotation of record.
[[rules]]
name = "vep_reannotate_plugins"
description = "Offline VEP + Wildtype/Frameshift plugins for pVACseq input"
when = "config.tumor_only == 'true'"
input = [
    "deliver/{pair_id}.somatic.pass.vcf.gz",
    "{config.genome_fa}",
]
output = [
    "neoantigen/{pair_id}/vep_plugins.vcf.gz",
    "neoantigen/{pair_id}/vep_plugins.vcf.gz.tbi",
]
log = "logs/vep_reannotate_{pair_id}.log"
threads = 8
memory = "32G"
environment = { pixi = "envs/vep_perl/pixi.toml" }
shell = """
mkdir -p neoantigen/{pair_id} logs && \
vep --input_file {input[0]} --output_file neoantigen/{pair_id}/vep_plugins.vcf --vcf --force_overwrite \
    --offline --cache --dir_cache {config.vep_perl_cache} \
    --assembly GRCh38 \
    --fasta {input[1]} \
    --hgvs --symbol --numbers --domains --protein --biotype --canonical --tsl \
    --dir_plugins {config.vep_plugins_dir} \
    --plugin Wildtype --plugin Frameshift \
    2> {log} && \
bgzip -@ 4 -c neoantigen/{pair_id}/vep_plugins.vcf > {output[0]} && \
tabix -f -p vcf {output[0]} && \
rm -f neoantigen/{pair_id}/vep_plugins.vcf
"""

# SpecHLA HLA typing from the BQSR WGS BAM. Organoid/tumor-only caveat is
# carried in the parsed allele table (no matched germline in this cohort).
[[rules]]
name = "hla_type_dna"
description = "SpecHLA HLA typing (8 classical loci) from WGS BAM"
when = "wildcard.assay == 'wgs'"
input = [
    "bqsr/{sample}/{sample}.bqsr.bam",
    "bqsr/{sample}/{sample}.bqsr.bai",
]
output = [
    "hla/{sample}/hla.result.txt",
    "hla/{sample}.alleles.tsv",
]
log = "logs/hla_type_dna/{sample}.log"
threads = 8
memory = "32G"
environment = { pixi = "envs/hla/pixi.toml" }
shell = """
# fresh-dir guard: SpecHLA reuses stale per-gene artifacts in an existing
# outdir, silently emitting empty typing (2026-11-04 live incident)
rm -rf hla/{sample} && \
mkdir -p hla/{sample} logs/hla_type_dna && \
spechla-extract-hla-reads -s {sample} -b {input[0]} -r hg38 -o hla/{sample} \
    > {log} 2>&1 && \
spechla -n {sample} -j {threads} \
    -1 hla/{sample}/{sample}_extract_1.fq.gz \
    -2 hla/{sample}/{sample}_extract_2.fq.gz \
    -o hla >> {log} 2>&1 && \
python {config.venus_tools}/hla_parse.py --sample {sample} \
    --result hla/{sample}/hla.result.txt \
    --g-group hla/{sample}/hla.result.g.group.txt \
    --mode tumor_only \
    --out {output[1]}
"""

# Ensembl gene_id -> HGNC symbol map, cached from the GTF (tiny; shared by
# every neoantigen report).
[[rules]]
name = "gene_symbol_map"
description = "Cache gene_id->symbol pairs from the GENCODE GTF"
input = ["{config.gencode_gtf}"]
output = ["ref/gene_symbols.tsv"]
threads = 4
memory = "8G"
environment = { pixi = "envs/qc/pixi.toml" }
shell = """
mkdir -p ref && \
echo -e "gene_id\\tsymbol" > {output} && \
awk -F'\\t' '$0 !~ /^#/ && $3 == "gene" { \
    match($9, /gene_id "[^"]+"/); gid = substr($9, RSTART+9, RLENGTH-10); \
    match($9, /gene_name "[^"]+"/); gname = substr($9, RSTART+11, RLENGTH-12); \
    print gid "\\t" gname }' {input[0]} >> {output}
"""

# pVACseq on the plugin-annotated VCF. P0 predictor = MHCflurry (open
# license); DTU tools (NetMHCpan/NetMHCIIpan) are absent on this deployment.
# Filter knobs are explicit (audit M1): exploratory percentile strategy =
# IC50-driven burden (no silent percentile pre-filter), VAF/depth coverage
# filters disabled so burden is not silently VAF>=0.25-clipped — reporting
# floors are applied downstream in neoantigen_report instead.
# sample_name = {experiment} (must match the VCF #CHROM column, audit B3).
[[rules]]
name = "pvacseq_run"
description = "pVACseq MHC-I neoantigen prediction (MHCflurry)"
when = "config.tumor_only == 'true'"
input = [
    "neoantigen/{pair_id}/vep_plugins.vcf.gz",
    "hla/{experiment}.alleles.tsv",
]
output = [
    "neoantigen/{pair_id}/filtered.tsv",
    "neoantigen/{pair_id}/alleles.txt",
]
log = "logs/pvacseq_{pair_id}.log"
threads = 8
memory = "32G"
environment = { pixi = "envs/pvac/pixi.toml" }
shell = """
mkdir -p neoantigen/{pair_id} logs && \
export MHCFLURRY_DATA_DIR={config.mhcflurry_data_dir} && \
python {config.venus_tools}/pvac_alleles.py \
    --alleles-tsv {input[1]} --min-alleles {config.neo_min_alleles} \
    --out {output[1]} && \
ALLELES=$(cat {output[1]}) && \
PURITY_ARG=""; \
[ -n "{config.neo_tumor_purity}" ] && PURITY_ARG="--tumor-purity {config.neo_tumor_purity}"; \
pvacseq run {input[0]} {experiment} "$ALLELES" \
    {config.neo_predictors} neoantigen/{pair_id}/run \
    --binding-threshold {config.neo_binding_nm} \
    --percentile-threshold-strategy exploratory \
    --tdna-vaf 0 --tdna-cov 0 \
    --top-score-metric lowest \
    --n-threads {threads} \
    $PURITY_ARG \
    > {log} 2>&1 && \
cp neoantigen/{pair_id}/run/MHC_Class_I/*.filtered.tsv {output[0]}
"""

# Per-patient burden report: candidates TSV + long summary + markdown, with
# expression filter from the pair's RNA featureCounts. The RNA sample name
# follows the venus cohort convention "{pair_id}-TR" (same key convention as
# groups.tsv bulkRNA); cohorts deviating from it should extend this rule.
#
# Tumor-only gating (venus#31 P1 item 5): when the optional scRNA
# corroboration is enabled (config.run_scrna_corr), the complementary twin
# rule neoantigen_report_scrna below takes over this rule's three output
# paths and passes the corroboration TSV as --scrna-corr (the engine has no
# conditional inputs; the msi_cohort / msi_cohort_tumoronly
# shared-output-path complementary-when-gate pattern). Exactly one of the
# two rules runs per pair, so the outputs are never produced twice.
[[rules]]
name = "neoantigen_report"
description = "Neoantigen burden + QC report (expression filter)"
when = "config.tumor_only == 'true' && config.run_scrna_corr != 'true'"
input = [
    "neoantigen/{pair_id}/filtered.tsv",
    "hla/{experiment}.alleles.tsv",
    "neoantigen/{pair_id}/alleles.txt",
    "rna/counts/{pair_id}-TR.featurecounts.txt",
    "ref/gene_symbols.tsv",
]
output = [
    "neoantigen/{pair_id}.candidates.tsv",
    "neoantigen/{pair_id}.summary.tsv",
    "neoantigen/{pair_id}.report.md",
]
log = "logs/neoantigen_report_{pair_id}.log"
threads = 2
memory = "8G"
environment = { pixi = "envs/qc/pixi.toml" }
shell = """
python {config.venus_tools}/neoantigen_report.py \
    --pvac-tsv {input[0]} \
    --hla-tsv {input[1]} \
    --usable-alleles {input[2]} \
    --counts {input[3]} \
    --gene-map {input[4]} \
    --patient {pair_id} \
    --mode tumor_only \
    --predictors '{config.neo_predictors}' \
    --strong-nm {config.neo_binding_nm} \
    --out-candidates {output[0]} \
    --out-summary {output[1]} \
    --out-md {output[2]} \
    2> {log}
"""

# pVACfuse on the Manta SV deliverable (venus#31 P1 item 1). Manta's BND
# records are converted to Arriba format by scripts/manta_to_arriba.py
# (declared input, same scripts-as-inputs pattern as clinical.oxoflow), then
# fed to pvacfuse (same envs/pvac as pvacseq: pvactools 7.1.5 + MHCflurry).
# Complementary when-gates mirror sv.oxoflow: the PAIRED deliverable
# (deliver/{pair_id}.sv.vcf.gz, PASS-only) for cohorts with normals, the
# tumor-only candidateSV for tumor-only cohorts — exactly one of the two
# rules can run per pair. Candidate SVs are explicitly UNSCORED calls: the
# tumor-only fusion TSV is written to a distinct filename (...fuse.candidate
# .filtered.tsv) so it is never confused with the PASS-scored one.
# pvacfuse with zero processable fusions exits 0 WITHOUT writing a
# filtered.tsv — the `||` fallback then writes an honest header-only TSV.
[[rules]]
name = "pvacfuse_run_paired"
description = "pVACfuse MHC-I fusion neoantigen prediction from Manta SV (paired)"
when = "config.tumor_only == 'true' && wildcard.control != ''"
input = [
    "deliver/{pair_id}.sv.vcf.gz",
    "{config.gencode_gtf}",
    "{config.genome_fa}",
    "hla/{experiment}.alleles.tsv",
    "{config.venus_tools}/manta_to_arriba.py",
    "{config.venus_tools}/pvac_alleles.py",
]
output = [
    "neoantigen/{pair_id}/fuse.filtered.tsv",
    "neoantigen/{pair_id}/fuse.alleles.txt",
]
log = "logs/pvacfuse_{pair_id}.log"
threads = 8
memory = "32G"
environment = { pixi = "envs/pvac/pixi.toml" }
shell = """
mkdir -p neoantigen/{pair_id} logs && \
rm -rf neoantigen/{pair_id}/fuse_run && \
export MHCFLURRY_DATA_DIR={config.mhcflurry_data_dir} && \
python {config.venus_tools}/manta_to_arriba.py \
    --vcf {input[0]} \
    --gencode {config.gencode_gtf} \
    --genome-fa {config.genome_fa} \
    --tumor-sample {experiment} \
    --output neoantigen/{pair_id}/fuse.arriba.tsv \
    2> {log} && \
python {config.venus_tools}/pvac_alleles.py \
    --alleles-tsv {input[3]} --min-alleles {config.neo_min_alleles} \
    --out {output[1]} && \
ALLELES=$(cat {output[1]}) && \
pvacfuse run neoantigen/{pair_id}/fuse.arriba.tsv {pair_id} "$ALLELES" \
    {config.neo_predictors} neoantigen/{pair_id}/fuse_run \
    --binding-threshold {config.neo_binding_nm} \
    --percentile-threshold-strategy exploratory \
    --top-score-metric lowest \
    --read-support 5 --expn-val 0.1 -d 1000 \
    --n-threads {threads} \
    >> {log} 2>&1 && \
cp neoantigen/{pair_id}/fuse_run/MHC_Class_I/*.filtered.tsv {output[0]} \
    2>/dev/null || \
printf 'fusion_id\tnote\\n\\tNo processable fusions from Manta SV (pvacfuse wrote no filtered.tsv)\\n' \
    > {output[0]}
"""

# Tumor-only companion: candidateSV (explicitly UNSCORED calls — Manta marks
# FILTER=.; not PASS) → distinct output filename for honesty.
[[rules]]
name = "pvacfuse_run_tumoronly"
description = "pVACfuse MHC-I fusion neoantigen prediction from Manta candidateSV (tumor-only)"
when = "config.tumor_only == 'true' && wildcard.control == ''"
input = [
    "deliver/{pair_id}.sv.candidate.vcf.gz",
    "{config.gencode_gtf}",
    "{config.genome_fa}",
    "hla/{experiment}.alleles.tsv",
    "{config.venus_tools}/manta_to_arriba.py",
    "{config.venus_tools}/pvac_alleles.py",
]
output = [
    "neoantigen/{pair_id}/fuse.candidate.filtered.tsv",
    "neoantigen/{pair_id}/fuse.alleles.txt",
]
log = "logs/pvacfuse_{pair_id}.log"
threads = 8
memory = "32G"
environment = { pixi = "envs/pvac/pixi.toml" }
shell = """
mkdir -p neoantigen/{pair_id} logs && \
rm -rf neoantigen/{pair_id}/fuse_run && \
export MHCFLURRY_DATA_DIR={config.mhcflurry_data_dir} && \
python {config.venus_tools}/manta_to_arriba.py \
    --vcf {input[0]} \
    --gencode {config.gencode_gtf} \
    --genome-fa {config.genome_fa} \
    --tumor-sample {experiment} \
    --output neoantigen/{pair_id}/fuse.arriba.tsv \
    2> {log} && \
python {config.venus_tools}/pvac_alleles.py \
    --alleles-tsv {input[3]} --min-alleles {config.neo_min_alleles} \
    --out {output[1]} && \
ALLELES=$(cat {output[1]}) && \
pvacfuse run neoantigen/{pair_id}/fuse.arriba.tsv {pair_id} "$ALLELES" \
    {config.neo_predictors} neoantigen/{pair_id}/fuse_run \
    --binding-threshold {config.neo_binding_nm} \
    --percentile-threshold-strategy exploratory \
    --top-score-metric lowest \
    --read-support 5 --expn-val 0.1 -d 1000 \
    --n-threads {threads} \
    >> {log} 2>&1 && \
cp neoantigen/{pair_id}/fuse_run/MHC_Class_I/*.filtered.tsv {output[0]} \
    2>/dev/null || \
printf 'fusion_id\\tnote\\n\\tNo processable fusions from Manta candidateSV (pvacfuse wrote no filtered.tsv; candidate SVs are unscored calls)\\n' \
    > {output[0]}
"""

# ---------------------------------------------------- scRNA corroboration ---
# venus#31 P1 item 5: %positive of each candidate gene in the pair's OWN
# single-cell profile, from scrna/count/{pair_id}/outs/filter_feature.h5ad
# (dnbc4tools), optionally split per cluster via outs/analysis/cluster.csv.
#
# HONEST CAVEAT (also embedded in the report text by neoantigen_report.py):
# the dnbc4tools h5ad has NO malignant-cell annotation, so %positive is over
# ALL filtered cells of the sample — a low value can mean low tumor fraction,
# not absent expression. The per-cluster breakdown is for eyeballing
# concentration only; no cluster is labeled malignant here.
#
# Input choice: the gene list comes from neoantigen/{pair_id}/filtered.tsv
# (pVACseq output), NOT from the report rule's candidates.tsv — consuming
# this rule's own downstream output would create a circular dependency.
#
# Environment: envs/scrna is the ONLY venus env with h5py (envs/report and
# envs/qc lack it); reusing it creates NO new env and NO new lock gap.
# Opt-in via config.run_scrna_corr (venus.oxoflow) — the h5ad only exists
# for cohorts that ran the scrna module, and envs/scrna computes the whole
# scanpy stack regardless.
[[rules]]
name = "scrna_corroboration"
description = "Per-gene %positive of neoantigen candidates in the pair's filter_feature.h5ad"
when = "config.tumor_only == 'true' && config.run_scrna_corr == 'true'"
input = [
    "scrna/count/{pair_id}/outs/filter_feature.h5ad",
    "neoantigen/{pair_id}/filtered.tsv",
    "scrna/count/{pair_id}/outs/analysis/cluster.csv",
    "{config.venus_tools}/scrna_corroboration.py",
]
output = ["scrna_corr/{pair_id}.tsv"]
protected_output = ["scrna_corr/{pair_id}.tsv"]
log = "logs/scrna_corr_{pair_id}.log"
threads = 2
memory = "8G"
environment = { pixi = "envs/scrna/pixi.toml" }
shell = """
mkdir -p scrna_corr logs && \
python {config.venus_tools}/scrna_corroboration.py \
    --h5ad {input[0]} \
    --pvac-tsv {input[1]} \
    --cluster {input[2]} \
    --out {output[0]} \
    2> {log}
"""

# Complementary twin of neoantigen_report (same three output paths,
# complementary when-gates — msi_cohort / msi_cohort_tumoronly pattern): the
# only difference is input[5], the corroboration TSV, passed as --scrna-corr.
[[rules]]
name = "neoantigen_report_scrna"
description = "Neoantigen burden + QC report (expression filter + scRNA corroboration)"
when = "config.tumor_only == 'true' && config.run_scrna_corr == 'true'"
input = [
    "neoantigen/{pair_id}/filtered.tsv",
    "hla/{experiment}.alleles.tsv",
    "neoantigen/{pair_id}/alleles.txt",
    "rna/counts/{pair_id}-TR.featurecounts.txt",
    "ref/gene_symbols.tsv",
    "scrna_corr/{pair_id}.tsv",
]
output = [
    "neoantigen/{pair_id}.candidates.tsv",
    "neoantigen/{pair_id}.summary.tsv",
    "neoantigen/{pair_id}.report.md",
]
log = "logs/neoantigen_report_{pair_id}.log"
threads = 2
memory = "8G"
environment = { pixi = "envs/qc/pixi.toml" }
shell = """
python {config.venus_tools}/neoantigen_report.py \
    --pvac-tsv {input[0]} \
    --hla-tsv {input[1]} \
    --usable-alleles {input[2]} \
    --counts {input[3]} \
    --gene-map {input[4]} \
    --scrna-corr {input[5]} \
    --patient {pair_id} \
    --mode tumor_only \
    --predictors '{config.neo_predictors}' \
    --strong-nm {config.neo_binding_nm} \
    --out-candidates {output[0]} \
    --out-summary {output[1]} \
    --out-md {output[2]} \
    2> {log}
"""
