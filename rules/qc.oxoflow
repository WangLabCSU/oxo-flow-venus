[workflow]
name = "venus-qc"
description = "Read QC and trimming: fastp + fastqc + multiqc"

# Trim adapters/low-quality bases and produce per-sample QC reports.
# Works for both WGS/WES (DNA) and bulk RNA FASTQs; single-cell FASTQs are
# processed raw by dnbc4tools and are excluded via the assay gate.
[[rules]]
name = "fastp"
description = "Adapter and quality trimming with fastp"
when = "wildcard.assay != 'scrna'"
input = [
    "raw/{sample}_R1.fastq.gz",
    "raw/{sample}_R2.fastq.gz",
]
output = [
    "qc/trim/{sample}_R1.trim.fastq.gz",
    "qc/trim/{sample}_R2.trim.fastq.gz",
    "qc/trim/{sample}.fastp.json",
    "qc/trim/{sample}.fastp.html",
]
log = "logs/fastp/{sample}.log"
threads = 8
memory = "16G"
environment = { pixi = "envs/qc/pixi.toml" }
shell = """
mkdir -p qc/trim logs/fastp && \
fastp \
    --in1 {input[0]} --in2 {input[1]} \
    --out1 {output[0]} --out2 {output[1]} \
    --json {output[2]} --html {output[3]} \
    --thread {threads} \
    --detect_adapter_for_pe \
    --cut_right --cut_right_window_size 4 --cut_right_mean_quality 20 \
    --qualified_quality_phred 20 --unqualified_percent_limit 30 \
    --n_base_limit 5 \
    --length_required 50 \
    2> {log}
"""

# Per-sample FastQC on trimmed reads.
[[rules]]
name = "fastqc"
description = "FastQC quality report on trimmed reads"
when = "wildcard.assay != 'scrna'"
input = [
    "qc/trim/{sample}_R1.trim.fastq.gz",
    "qc/trim/{sample}_R2.trim.fastq.gz",
]
output = [
    "qc/fastqc/{sample}_R1.trim_fastqc.html",
    "qc/fastqc/{sample}_R2.trim_fastqc.html",
]
log = "logs/fastqc/{sample}.log"
threads = 4
memory = "4G"
environment = { pixi = "envs/qc/pixi.toml" }
shell = """
mkdir -p qc/fastqc logs/fastqc && \
fastqc --threads {threads} --outdir qc/fastqc {input} 2> {log}
"""

# Cohort-wide MultiQC aggregation over fastp + fastqc outputs.
# Declared {sample}-wildcard inputs would duplicate the expand_inputs entries,
# so only the expansions are declared; the shell scans the workdir directly.
# Expanded over DNA + bulkRNA groups (config.samples_<group> keys are
# auto-injected from groups.tsv): scRNA samples have no fastp/fastqc outputs.
[[rules]]
name = "multiqc"
description = "Aggregate all QC reports with MultiQC"
output = [
    "qc/multiqc/multiqc_report.html",
    "qc/multiqc/multiqc_report_data/multiqc_general_stats.txt",
]
expand_inputs = [
    { pattern = "qc/trim/{sample}.fastp.json", variables = { sample = "config.samples_DNA" } },
    { pattern = "qc/trim/{sample}.fastp.json", variables = { sample = "config.samples_bulkRNA" } },
    { pattern = "qc/fastqc/{sample}_R1.trim_fastqc.html", variables = { sample = "config.samples_DNA" } },
    { pattern = "qc/fastqc/{sample}_R1.trim_fastqc.html", variables = { sample = "config.samples_bulkRNA" } },
    { pattern = "qc/fastqc/{sample}_R2.trim_fastqc.html", variables = { sample = "config.samples_DNA" } },
    { pattern = "qc/fastqc/{sample}_R2.trim_fastqc.html", variables = { sample = "config.samples_bulkRNA" } },
]
log = "logs/multiqc.log"
threads = 4
memory = "8G"
environment = { pixi = "envs/qc/pixi.toml" }
shell = """
mkdir -p qc/multiqc logs && \
multiqc . --filename multiqc_report --outdir qc/multiqc --force --ignore "*_STARtmp*" 2> {log}
"""
