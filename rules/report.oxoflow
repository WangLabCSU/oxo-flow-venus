[workflow]
name = "venus-report"
description = "Cohort-level clinical report: methods from actual rule_runs, per-pair TMB, cohort summary, HTML delivery"

# Methods section generated from the oxo-flow run checkpoint (rule_runs) — the
# report describes the commands that ACTUALLY executed (methods = ground truth).
# The checkpoint lives in .oxo-flow/ (engine-owned, not a rule product): the
# shell reads it at execution time, so it is not declared as rule input.
# `report/cohort_summary.tsv` is declared as a REAL input dependency: it is the
# join point of the analytical chain (TMB / RNA-QC / scRNA / ASCAT / MSI), so
# this rule is scheduled at the END of the run, when the checkpoint is fully
# populated. With only `config/pairs.tsv` as input the rule fired seconds
# after launch, read an empty checkpoint and emitted an empty methods
# section (#5).
[[rules]]
name = "methods_from_rule_runs"
description = "Extract methods narrative from executed rule_runs"
input = [
    "config/pairs.tsv",
    "report/cohort_summary.tsv",
]
output = ["report/methods_section.md"]
# Keep: report module outputs are the clinical deliverables.
protected_output = ["report/methods_section.md"]
threads = 2
memory = "4G"
environment = { pixi = "envs/report/pixi.toml" }
shell = """
mkdir -p report logs && \
python {config.venus_tools}/methods_from_rule_runs.py \
    --checkpoint .oxo-flow/checkpoint.json \
    --rules-dir rules \
    --workflow venus.oxoflow \
    --output {output[0]} \
    2> logs/methods_from_rule_runs.log
"""

# Per-pair TMB (mutations/Mb) from the delivery MAF (one-row TSV per pair).
# Dual convention: tmb_mut_per_mb = coding non-silent / coding Mb (clinical
# convention, comparable with the >=10 mut/Mb cutoff for BOTH WGS and WES —
# --coding-mb defaults to ~34 Mb CCDS, shrunk to the BED total for WES);
# all_somatic_mut_per_mb = ALL PASS somatic variants / target Mb (WGS
# literature convention; tmb_target_args passes --target-bed <bed> for WES,
# which computes the honest denominator from merged intervals).
[[rules]]
name = "tmb_per_pair"
description = "Compute TMB per pair from delivery MAF"
input = ["deliver/{pair_id}.maf"]
output = ["report/tmb/{pair_id}.tmb.tsv"]
# Keep: report module outputs are the clinical deliverables.
protected_output = ["report/tmb/{pair_id}.tmb.tsv"]
threads = 2
memory = "4G"
environment = { pixi = "envs/report/pixi.toml" }
shell = """
mkdir -p report/tmb logs && \
python {config.venus_tools}/tmb_from_maf.py \
    --mafs {input[0]} \
    --target-mb {config.target_mb} \
    {config.tmb_target_args} \
    --output {output[0]} \
    2> logs/tmb_{pair_id}.log
"""

# Cohort single-cell metrics table from dnbc4tools metrics_summary.xls files.
[[rules]]
name = "scrna_metrics_cohort"
description = "Collect per-sample single-cell metrics into cohort table"
expand_inputs = [
    { pattern = "scrna/count/{sample}/outs/metrics_summary.xls", variables = { sample = "config.samples_scRNA" } },
]
output = ["report/scrna_metrics.tsv"]
# Keep: report module outputs are the clinical deliverables.
protected_output = ["report/scrna_metrics.tsv"]
threads = 2
memory = "4G"
environment = { pixi = "envs/report/pixi.toml" }
shell = """
mkdir -p report logs && \
python {config.venus_tools}/scrna_metrics.py \
    --metrics {input} \
    --samples {config.samples_scRNA} \
    --output {output[0]} \
    2> logs/scrna_metrics.log
"""

# Cohort MSI table. MSIsensor v1.3.0 has a uint16 rank bug in calculateFDR:
# above 65,535 sites the reported unstable-site count saturates (Pt09 hits
# exactly 65,535). collect_msi.py recomputes a proper Benjamini-Hochberg FDR
# from the raw per-site output (msi/<pair>_all, P_value = column 8) and
# reports reported vs BH-corrected counts side by side. Lives in the report
# module (not rules/msi.oxoflow) because it is a post-hoc re-analysis of
# delivered outputs, not an MSI caller step.
[[rules]]
name = "msi_cohort"
description = "Collect MSI summaries with BH-corrected unstable counts"
expand_inputs = [
    { pattern = "deliver/{pair_id}.msi.tsv", variables = { pair_id = "config.pairs_list" } },
    { pattern = "msi/{pair_id}_all", variables = { pair_id = "config.pairs_list" } },
]
output = ["report/msi_cohort.tsv"]
# Keep: report module outputs are the clinical deliverables.
protected_output = ["report/msi_cohort.tsv"]
threads = 2
memory = "4G"
environment = { pixi = "envs/report/pixi.toml" }
# Tumor-only gating: msi_paired carries when = "wildcard.control != ''", so
# in a tumor-only cohort its deliver/{pair_id}.msi.tsv and msi/{pair_id}_all
# inputs are unproducible and this rule fails on every run. Gate it off when
# the cohort is declared tumor-only (config.tumor_only, venus.oxoflow); the
# companion rule msi_cohort_tumoronly then writes the header-only table that
# keeps cohort_tables alive. A MIXED cohort (some pairs with a control, some
# without) still fails here on the tumor-only pairs — see README
# "Tumor-only cohorts".
when = "config.tumor_only != 'true'"
shell = """
mkdir -p report logs && \
python {config.venus_tools}/collect_msi.py \
    --inputs {input} \
    --output {output[0]} \
    2> logs/msi_cohort.log
"""

# Tumor-only companion of msi_cohort: same output path, complementary
# when-gate (the cnvkit_paired/cnvkit_tumoronly shared-output-path pattern).
# MSIsensor-pro needs a matched normal both for calling and for the baseline
# (a PoN cannot be built from one tumor-only cohort — see rules/msi.oxoflow),
# so a tumor-only cohort has no .msi.tsv / _all inputs to collect; the
# header-only table keeps cohort_tables / clinical_report alive and the
# report renders the MSI section as "no data" (tsv_markdown). Column names
# mirror collect_msi.py's output header exactly.
[[rules]]
name = "msi_cohort_tumoronly"
description = "Write header-only MSI cohort table (tumor-only cohort)"
input = []
output = ["report/msi_cohort.tsv"]
# Keep: same shared output path as msi_cohort — report-facing.
protected_output = ["report/msi_cohort.tsv"]
threads = 2
memory = "4G"
environment = { pixi = "envs/report/pixi.toml" }
when = "config.tumor_only == 'true'"
shell = """
mkdir -p report logs && \
printf 'sample\traw_total_sites\tsummary_total_sites\treported_unstable\treported_pct\tbh_unstable\tbh_pct\tunstable_delta\tuint16_saturated\tmsi_status_wgs\tmsi_status_wes\n' \
    > report/msi_cohort.tsv && \
printf '[msi_cohort_tumoronly] tumor-only cohort: header-only table (MSI needs a matched normal)\n' \
    > logs/msi_cohort.log
"""

# Cohort ecDNA table from the AmpliconClassifier outputs of the ampliconsuite
# rule (ecdna/<pair>/<pair>_ecDNA_counts.tsv + _result_table.tsv). Works in
# BOTH cohort modes: the suite takes the tumor BAM only (its internal CNVkit
# step is tumor-only via the AA_DATA_REPO prebuilt reference), so there is no
# paired/tumor-only split here. 0-amplicon samples are safe: the suite still
# writes the counts TSV (one row, count 0) and collect_ecdna.py keeps that row.
[[rules]]
name = "ecdna_cohort"
description = "Collect per-pair ecDNA counts and oncogene hits into cohort tables"
expand_inputs = [
    { pattern = "ecdna/{pair_id}/{pair_id}_ecDNA_counts.tsv", variables = { pair_id = "config.pairs_list" } },
    { pattern = "ecdna/{pair_id}/{pair_id}_result_table.tsv", variables = { pair_id = "config.pairs_list" } },
]
output = [
    "report/cohort_ecdna.tsv",
    "report/ecdna_genes.tsv",
]
# Keep: report module outputs are the clinical deliverables.
protected_output = [
    "report/cohort_ecdna.tsv",
    "report/ecdna_genes.tsv",
]
threads = 2
memory = "4G"
environment = { pixi = "envs/report/pixi.toml" }
shell = """
mkdir -p report logs && \
python {config.venus_tools}/collect_ecdna.py \
    --inputs {input} \
    --counts-output {output[0]} \
    --genes-output {output[1]} \
    2> logs/ecdna_cohort.log
"""

# Aggregate TMB + RNA QC + single-cell metrics + ecDNA + ASCAT + MSI into one
# PATIENT-level cohort table. {input} expands to the full combined input
# list (declared inputs first, then expand_inputs results); cohort_tables.py
# routes every file by BASENAME (rna_qc_summary / scrna_metrics /
# cohort_ascat / cohort_ecdna / msi_cohort / else TMB), so ordering does not
# matter. Sample keys are normalized to patient level (strips -TD/-B/-TR) so
# each patient row carries tmb_* + rna_* + sc_* + ecdna_* + ascat_* + msi_*
# columns.
[[rules]]
name = "cohort_tables"
description = "Outer-join per-module tables into patient-level cohort summary"
input = [
    "rna/qc/rna_qc_summary.tsv",
    "report/scrna_metrics.tsv",
    "ascat/cohort_ascat.tsv",
    "report/cohort_ecdna.tsv",
    "report/msi_cohort.tsv",
]
expand_inputs = [
    { pattern = "report/tmb/{pair_id}.tmb.tsv", variables = { pair_id = "config.pairs_list" } },
]
output = ["report/cohort_summary.tsv"]
# Keep: report module outputs are the clinical deliverables.
protected_output = ["report/cohort_summary.tsv"]
threads = 2
memory = "4G"
environment = { pixi = "envs/report/pixi.toml" }
shell = """
mkdir -p report logs && \
python {config.venus_tools}/cohort_tables.py \
    --inputs {input} \
    --output {output[0]} \
    2> logs/cohort_tables.log
"""

# Final clinical report (Markdown + HTML), methods from actual execution.
# Interpretation is rule-based (computed from the cohort table by
# clinical_report.py); cohort-specific narrative comes from
# notes/interpretation.md (a tracked source file, not a rule product).
[[rules]]
name = "clinical_report"
description = "Render final cohort report (Markdown + HTML)"
input = [
    "report/methods_section.md",
    "report/cohort_summary.tsv",
    "rna/qc/rna_qc_summary.tsv",
    "report/scrna_metrics.tsv",
    "notes/interpretation.md",
    "ascat/cohort_ascat.tsv",
    "report/cohort_ecdna.tsv",
    "report/msi_cohort.tsv",
    "report/clinical_cohort.tsv",
]
output = [
    "report/venus_clinical_report.md",
    "report/venus_clinical_report.html",
]
# Keep: the final clinical deliverable.
protected_output = [
    "report/venus_clinical_report.md",
    "report/venus_clinical_report.html",
]
threads = 2
memory = "4G"
environment = { pixi = "envs/report/pixi.toml" }
shell = """
mkdir -p report logs && \
python {config.venus_tools}/clinical_report.py \
    --methods {input[0]} \
    --tmb {input[1]} \
    --rna-qc {input[2]} \
    --scrna-metrics {input[3]} \
    --notes {input[4]} \
    --ascat {input[5]} \
    --ecdna {input[6]} \
    --msi {input[7]} \
    --clinical {input[8]} \
    --pairs config/pairs.tsv \
    --output-md {output[0]} \
    --output-html {output[1]} \
    2> logs/clinical_report.log
"""
