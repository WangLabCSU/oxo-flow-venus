[workflow]
name = "venus-ascat"
description = "ASCAT allelic copy-number, purity and ploidy for paired WGS"

# ASCAT v3.2 HTS chain (VanLoo-lab official docs), orchestrated as in
# gcap::gcap.runASCAT (Wang et al. 2024, Nat Commun 15:3231):
#   prepareHTS -> loadData -> correctLogR -> plotRawData ->
#   aspcf(gg=NULL) -> plotSegmentedData -> runAscat(gamma=1) -> metrics.
# WGS mode: no BED, penalty=70, GC + replication-timing correction
# (G1000 reference from ASCAT Zenodo record 14008443), gamma=1.
# Autosomes 1:22 only: patient sex is unannotated, so sex chromosomes are
# excluded from the fit (gender fixed to "XX"; see method rationale).
#
# GC/RT correction files are declared as rule inputs; the per-chromosome
# loci/alleles file sets are addressed through config.ascat_refdir (tracked
# via config meta, one directory rather than 44 files).
[[rules]]
name = "ascat_paired"
description = "ASCAT purity/ploidy and allelic segmentation with matched normal"
input = [
    "bqsr/{experiment}/{experiment}.bqsr.bam",
    "bqsr/{control}/{control}.bqsr.bam",
    "{config.venus_tools}/run_ascat.R",
    "{config.ascat_refdir}/GC_G1000_WGS_hg38.txt",
    "{config.ascat_refdir}/RT_G1000_WGS_hg38.txt",
]
output = [
    "ascat/{pair_id}/{pair_id}.ASCAT.rds",
    "ascat/{pair_id}/purity_ploidy.tsv",
    "ascat/{pair_id}/segments.tsv",
    "ascat/{pair_id}/metrics.tsv",
    "ascat/{pair_id}/{experiment}_tumourLogR.txt",
    "ascat/{pair_id}/{experiment}_tumourBAF.txt",
    "ascat/{pair_id}/plots/{pair_id}.{experiment}.tumour.png",
    "ascat/{pair_id}/plots/{pair_id}.{experiment}.germline.png",
    "ascat/{pair_id}/plots/{pair_id}.{experiment}.ASPCF.png",
    "ascat/{pair_id}/plots/{pair_id}.{experiment}.ASCATprofile.pdf",
]
# Keep ALL: the ASCAT fit is the single most expensive CNV step (~hours/pair,
# 22 threads) and every product is report-facing (purity/ploidy, segments,
# LogR/BAF tables, plots). Never scratch.
protected_output = [
    "ascat/{pair_id}/{pair_id}.ASCAT.rds",
    "ascat/{pair_id}/purity_ploidy.tsv",
    "ascat/{pair_id}/segments.tsv",
    "ascat/{pair_id}/metrics.tsv",
    "ascat/{pair_id}/{experiment}_tumourLogR.txt",
    "ascat/{pair_id}/{experiment}_tumourBAF.txt",
    "ascat/{pair_id}/plots/{pair_id}.{experiment}.tumour.png",
    "ascat/{pair_id}/plots/{pair_id}.{experiment}.germline.png",
    "ascat/{pair_id}/plots/{pair_id}.{experiment}.ASPCF.png",
    "ascat/{pair_id}/plots/{pair_id}.{experiment}.ASCATprofile.pdf",
]
threads = 22
memory = "64G"
environment = { pixi = "envs/ascat/pixi.toml" }
when = "wildcard.control != ''"
shell = """
mkdir -p ascat/{pair_id} logs && \
Rscript {input[2]} \
    --tumor {input[0]} \
    --normal {input[1]} \
    --tumor-name {experiment} \
    --normal-name {control} \
    --job {pair_id} \
    --outdir ascat/{pair_id} \
    --refdir {config.ascat_refdir} \
    --gc {input[3]} \
    --rt {input[4]} \
    --threads {threads} \
    2> logs/ascat_{pair_id}.log
"""

# Concatenate the per-pair purity/ploidy tables into one cohort table for
# the report module (clinical_report / cohort_summary consume it). Uses the
# report environment because it only needs Python.
#
# Tumor-only gating: ascat_paired carries when = "wildcard.control != ''", so
# in a tumor-only cohort NO instance of ascat_paired is instantiated and the
# expanded input ascat/{pair_id}/purity_ploidy.tsv is unproducible — without a
# matching when-gate this rule fails on every run (and, with keep-going,
# retries pointlessly and blocks cohort_tables). Gate it off when the cohort
# is declared tumor-only (config.tumor_only, venus.oxoflow — same string-flag
# convention as run_bqsr); the companion rule ascat_cohort_tumoronly then
# writes the header-only table that keeps the report chain alive. A MIXED
# cohort (some pairs with a control, some without) still fails here on the
# pairs that have no purity_ploidy.tsv — collect_ascat.py tolerates missing
# files, but the expand_inputs fan-out itself does not; see README
# "Tumor-only cohorts".
[[rules]]
name = "ascat_cohort"
description = "Concatenate per-pair ASCAT purity/ploidy into cohort table"
expand_inputs = [
    { pattern = "ascat/{pair_id}/purity_ploidy.tsv", variables = { pair_id = "config.pairs_list" } },
]
output = ["ascat/cohort_ascat.tsv"]
# Keep: cohort purity/ploidy table consumed by cohort_tables + clinical_report.
protected_output = ["ascat/cohort_ascat.tsv"]
threads = 2
memory = "4G"
environment = { pixi = "envs/report/pixi.toml" }
when = "config.tumor_only != 'true'"
shell = """
mkdir -p ascat logs && \
python {config.venus_tools}/collect_ascat.py \
    --inputs {input} \
    --output {output[0]} \
    2> logs/ascat_cohort.log
"""

# Tumor-only companion of ascat_cohort: same output path, complementary
# when-gate (the cnvkit_paired/cnvkit_tumoronly shared-output-path pattern).
# ASCAT is paired-only (the allelic fit needs a matched normal), so a
# tumor-only cohort has no purity_ploidy.tsv to collect; the header-only
# table keeps cohort_tables / clinical_report / methods_from_rule_runs live
# and the report renders the ASCAT section as "no data" (tsv_markdown).
# Column names mirror run_ascat.R's purity_ploidy data.frame exactly.
[[rules]]
name = "ascat_cohort_tumoronly"
description = "Write header-only ASCAT cohort table (tumor-only cohort)"
input = []
output = ["ascat/cohort_ascat.tsv"]
# Keep: same shared output path as ascat_cohort — report-facing.
protected_output = ["ascat/cohort_ascat.tsv"]
threads = 2
memory = "4G"
environment = { pixi = "envs/report/pixi.toml" }
when = "config.tumor_only == 'true'"
shell = """
mkdir -p ascat logs && \
printf 'pair\tsample\tpurity\tploidy\tpsi\taberrant_cell_fraction\tgoodness_of_fit\tnon_aberrant\tfailed\tn_segments\n' \
    > ascat/cohort_ascat.tsv && \
printf '[ascat_cohort_tumoronly] tumor-only cohort: header-only table (ASCAT needs a matched normal)\n' \
    > logs/ascat_cohort.log
"""
